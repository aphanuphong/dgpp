          "text": "```python\n\"\"\"\nModule for parsing OpenAI-style Server-Sent Events (SSE) streams of chat completion chunks\ninto a single message object.\n\nThis module provides functionality to:\n1. Parse individual SSE lines from an OpenAI chat completion stream.\n2. Aggregate multiple chunks into a single complete message.\n3. Handle various edge cases such as empty deltas, role-only chunks, and finish reasons.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass, field\nfrom typing import Any, Iterator, Optional\n\n\n@dataclass\nclass ChatMessage:\n    \"\"\"\n    Represents a single chat message with role, content, and optional metadata.\n\n    Attributes:\n        role: The role of the message (e.g., 'assistant', 'user', 'system').\n        content: The text content of the message.\n        finish_reason: The reason the model stopped generating tokens, if any.\n        raw_chunks: The list of raw chunk dictionaries that were aggregated.\n    \"\"\"\n    role: str = \"\"\n    content: str = \"\"\n    finish_reason: Optional[str] = None\n    raw_chunks: list[dict[str, Any]] = field(default_factory=list)",
