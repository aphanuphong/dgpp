+  float acc[2][4][4] = {};
+#pragma unroll
+  for (int kk = 0; kk < 128; kk += 32) {
+    uint32_t af[2][4], bf[4][2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const unsigned addr = static_cast<unsigned>(__cvta_generic_to_shared(
+          a + (i * 16 + lane % 16) * S + kk + (lane / 16) * 16));
