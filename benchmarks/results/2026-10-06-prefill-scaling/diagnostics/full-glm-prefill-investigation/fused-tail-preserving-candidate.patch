+  const int64_t visible = min((pos[r] + 1) / kpool, pools);
+  if (visible <= select_k || p0 >= visible) return;
+  const int tid = threadIdx.x, warp = tid / 32, lane = tid % 32;
+  for (int i = tid; i < 32 * 8; i += 128) {
