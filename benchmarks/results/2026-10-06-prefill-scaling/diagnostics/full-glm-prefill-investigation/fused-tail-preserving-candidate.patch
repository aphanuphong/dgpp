+      for (size_t i = 0; i < q.size(); ++i) q[i] = code(hash32(uint32_t(i + 173)));
+      for (size_t i = 0; i < k.size(); ++i) k[i] = code(hash32(uint32_t(i + 479)));
+      if (mode == 2) std::fill(q.begin(), q.end(), 0);  // exact ties
